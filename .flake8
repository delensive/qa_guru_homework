[flake8]
max-line-length = 90
extend-ignore = E501, E203, W503, F811
per-file-ignores =
    settings*.py:E402,F403,F405
    */__init__.py:F401
exclude =
    .git,
    .venv,
    venv,
    env,
    .idea,
    __pycache__,
    .tox,
    .eggs,
    *.egg,
    .pytest_cache,
    allure-results,
    allure-report,
    main.py,
    infra/api_core